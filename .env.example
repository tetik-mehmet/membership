# MongoDB Connection
# For local development: mongodb://localhost:27017/membership_management
# For production (MongoDB Atlas): mongodb+srv://username:password@cluster.mongodb.net/membership_management
MONGODB_URI=your_mongodb_connection_string

# JWT Secret (IMPORTANT: Use a strong, random secret in production - minimum 32 characters)
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_min_32_chars

# Node Environment
NODE_ENV=production

# Admin Giriş/Çıkış Logları - Sadece bu kullanıcı adına sahip admin logları görüntüleyebilir
# Örnek: admin
NEXT_PUBLIC_ACTIVITY_LOG_VIEWER_USERNAME=admin
